---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/header/header.astro";
import Hero from "@/components/partials/hero/hero.astro";
import Number from "@/components/partials/number/number.astro";
import Cost from "@/components/partials/cost/cost.astro";
import Risk from "@/components/partials/risks/risk.astro";
import Doctors from "@/components/partials/doctors/doctors.astro";
import CostDepends from "@/components/partials/costdepends/costdepends.astro";
import InsurenceAdvisor from "@/components/partials/insurenceadvisor/insurenceadvisor.astro";
import Why from "@/components/partials/why/why.astro";
import Google from "@/components/partials/google/google.astro";
