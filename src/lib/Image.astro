---
// Astro twin of lib/Image.tsx (the next/image replacement), for .astro components.
// Renders a plain <img> with the same `fill` layout and loading hints.
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "style"> & {
  src: string;
  alt: string;
  fill?: boolean;
  priority?: boolean;
  preload?: boolean;
  quality?: number;
  style?: Record<string, string | number>;
};

const {
  src,
  fill,
  priority,
  preload,
  quality: _quality,
  loading,
  fetchpriority,
  style = {},
  ...rest
} = Astro.props;

const finalSrc = src.includes(" ") ? encodeURI(src) : src;
const eager = priority || preload;

const fillStyle = {
  position: "absolute",
  height: "100%",
  width: "100%",
  inset: 0,
  color: "transparent",
};
---

<img
  {...rest}
  src={finalSrc}
  loading={loading ?? (eager ? "eager" : "lazy")}
  fetchpriority={fetchpriority ?? (eager ? "high" : undefined)}
  decoding="async"
  style={fill ? { ...fillStyle, ...style } : { color: "transparent", ...style }}
/>
