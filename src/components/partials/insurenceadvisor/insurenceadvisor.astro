---
// Astro port of insurenceadvisor.jsx (static).
// First card: desktop → WhatsApp, mobile → call (ContactCta).
// Second card ("Call Our Advisors"): call on desktop + mobile.
import ContactCta from "@/components/ContactCta.astro";
import { getPhoneForPath, toTel } from "@/constants/contact";

type Card = {
  titlePrefix?: string;
  titleHighlight?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  buttonText?: string;
};

type Props = { cards: Card[] };

const { cards } = Astro.props;
const phoneNumber = getPhoneForPath(Astro.url.pathname);

const buttonClass =
  "mt-auto rounded-full bg-[#625587] px-7 py-3.5 text-white font-semibold text-lg shadow hover:bg-white hover:text-black hover:border border-[#625587] transition flex items-center justify-center";
---

<section class="w-full max-w-5xl mx-auto px-0 md:px-4 py-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {cards.map((card, idx) => (
      <div class="flex flex-col rounded-3xl bg-white border border-gray-100 px-6 md:px-10 py-6 shadow-sm gap-4">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 leading-snug">{card.titlePrefix} <span class="text-[#625587]">{card.titleHighlight}</span></h2>

          <p class="mt-3 text-gray-700 text-lg leading-relaxed">{card.description}</p>

          {card.image && (
            <img src={card.image} alt={card.imageAlt || card.titleHighlight} loading="lazy" decoding="async" class="mt-6 w-56 mx-auto" />
          )}
        </div>

        {idx === 1 ? (
          <a href={toTel(phoneNumber)} class={buttonClass}>{card.buttonText}</a>
        ) : (
          <ContactCta class={buttonClass}>{card.buttonText}</ContactCta>
        )}
      </div>
    ))}
  </div>
</section>
