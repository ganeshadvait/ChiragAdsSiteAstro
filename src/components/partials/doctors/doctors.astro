---
// Astro port of doctors.jsx. "More" doctors are hidden on mobile until the
// View More button is pressed; always visible from sm up.
import Image from "@/lib/Image.astro";
import ContactCta from "@/components/ContactCta.astro";

type Doctor = {
  img: string;
  name: string;
  designation?: string;
  qualification?: string;
  experience?: string;
};

type Banner = {
  heading?: string;
  points?: string[];
  buttonText?: string;
  imageSrc?: string;
};

type Props = {
  heading?: string;
  topDoctors: Doctor[];
  moreDoctors: Doctor[];
  banner?: Banner;
};

const { heading, topDoctors, moreDoctors, banner = {} } = Astro.props;
const { heading: bannerHeading = "", points = [], buttonText = "", imageSrc = "" } = banner;
---

<section id="doctors" class="w-full max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-4 mb-0" data-doctors>
  {/* TITLE */}
  <h2 class="text-[24px] sm:text-[28px] lg:text-[30px] text-[#625587] text-center font-semibold mb-8">{heading}</h2>

  {/* DOCTORS GRID */}
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-5 items-stretch">
    {[...topDoctors.map((doc) => ({ doc, more: false })), ...moreDoctors.map((doc) => ({ doc, more: true }))].map(({ doc, more }) => {
      const card = (
        <div class="bg-white rounded-2xl shadow-md px-3 sm:px-4 py-4 h-full">
          <div class="flex gap-3 xl:gap-4 items-stretch h-full">
            {/* IMAGE */}
            <div class="w-16 sm:w-[72px] xl:w-20 flex-shrink-0 self-stretch">
              <img src={doc.img} alt={doc.name} loading="lazy" decoding="async" class="w-full h-full rounded-xl object-cover object-top" />
            </div>

            {/* CONTENT */}
            <div class="flex flex-col justify-between flex-1 min-w-0">
              <div>
                <p class="text-[15px] font-semibold text-gray-900">{doc.name}</p>

                <p class="text-gray-700 mt-1 text-[12px] leading-snug">{doc.designation}</p>

                <p class="text-gray-700 mt-1 text-[12px] leading-snug">{doc.qualification}</p>

                <p class="text-[12px] text-gray-500 mt-1">Experience: <span class="text-gray-900">{doc.experience}</span></p>
              </div>

              {/* CTA – never wider than the card */}
              <ContactCta
                class="mt-3 block w-full max-w-[180px] text-center
    border-2 border-[#625587] text-[#625587]
    rounded-full px-2 py-2 text-[12px] xl:text-[13px] font-medium
    hover:bg-[#625587] hover:text-white transition"
              >Book Appointment</ContactCta>
            </div>
          </div>
        </div>
      );
      return more ? <div class="hidden sm:block h-full" data-doctors-more>{card}</div> : card;
    })}
  </div>

  {moreDoctors.length > 0 && (
    <div class="flex justify-center mt-8 sm:hidden">
      <button
        class="border-2 border-[#625587] text-[#625587]
            rounded-full px-8 py-2 text-sm font-semibold
            hover:bg-[#625587] hover:text-white transition"
        data-doctors-toggle
      >View More Doctors</button>
    </div>
  )}

  {/* Consult Banner */}
  <div class="w-full bg-[#9e8dce] rounded-2xl my-6 overflow-hidden">
    <div class="flex flex-col md:flex-row md:items-stretch items-center justify-between gap-6 lg:gap-8">
      {/* LEFT */}
      <div class="flex flex-col items-start justify-center gap-4 w-full md:w-[55%] lg:w-1/2 p-6 lg:p-8">
        <h2 class="text-[24px] sm:text-[26px] lg:text-[28px] xl:text-[32px] font-semibold text-white">{bannerHeading}</h2>

        <ul class="text-white text-[15px] md:text-[16px] xl:text-[18px] list-disc pl-5 space-y-2">
          {points.map((point) => <li>{point}</li>)}
        </ul>

        <ContactCta
          class="inline-block rounded-full bg-[#f8b956] px-6 md:px-8 py-3 md:py-4 text-sm font-medium text-white
            hover:bg-[#e0a644] transition"
        >{buttonText}</ContactCta>
      </div>

      {/* RIGHT IMAGE */}
      <div class="hidden md:flex md:w-[45%] lg:w-1/2 justify-center items-end px-4">
        <div class="relative w-full max-w-[320px] lg:max-w-[380px] xl:max-w-md aspect-[5/4]">
          <Image
            src={imageSrc}
            alt={bannerHeading}
            fill
            sizes="(max-width: 1024px) 320px, (max-width: 1280px) 380px, 28rem"
            class="object-contain object-bottom"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-doctors]").forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>("[data-doctors-toggle]");
    if (!toggle) return;
    const more = Array.from(root.querySelectorAll<HTMLElement>("[data-doctors-more]"));
    let showMore = false;
    toggle.addEventListener("click", () => {
      showMore = !showMore;
      more.forEach((el) => {
        el.classList.toggle("block", showMore);
        el.classList.toggle("hidden", !showMore);
      });
      toggle.textContent = showMore ? "View Less" : "View More Doctors";
    });
  });
</script>
