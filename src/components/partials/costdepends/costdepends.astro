---
// Astro port of costdepends.jsx (static).
import ContactCta from "@/components/ContactCta.astro";

type Item = { icon: string; titleBold: string; titleRest?: string };

type Props = {
  heading?: string;
  items: Item[];
  ctaText?: string;
};

const { heading, items, ctaText } = Astro.props;
---

<section class="w-full max-w-5xl mx-auto px-0 md:px-4 py-6">
  <h2 class="text-[24px] sm:text-[32px] font-semibold text-[#625587] mb-8 text-center">{heading}</h2>

  <div class="border border-emerald-400 rounded-3xl px-6 pt-6 pb-4 bg-white shadow-sm">
    {/* Factors */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {items.map((item) => (
        <div class="flex flex-col items-center text-center space-y-3">
          <div class="w-24 h-24 rounded-full bg-[#ccebe5] flex items-center justify-center">
            <img src={item.icon} alt={item.titleBold} loading="lazy" decoding="async" class="w-10 h-10 object-contain" />
          </div>

          <div class="text-sm leading-snug">
            <p class="font-semibold text-gray-900">{item.titleBold}</p>
            <p class="text-gray-700">{item.titleRest}</p>
          </div>
        </div>
      ))}
    </div>

    {/* CTA */}
    <ContactCta class="mt-6 w-full bg-[#17a388] text-white font-semibold rounded-full py-3.5 flex items-center justify-center gap-2 text-lg hover:bg-emerald-700 transition"><span>{ctaText}</span></ContactCta>
  </div>
</section>
