---
import Image from "@/lib/Image.astro";
import DoctorsData from "@/data/doctorsdata";
import ContactCta from "@/components/ContactCta.astro";

interface Props {
  heading: string;
  subheading?: string;
  points: string[];
  buttonText: string;
  imageSrc?: string;
}

const { heading, subheading = "", points, buttonText, imageSrc } = Astro.props;

const doctor = DoctorsData.Proctology["Dr. Rajasekhar"];

const doctorInfo = {
  name: doctor.name,
  qualifications: doctor.qualification,
  designation: doctor.designation,
  experience: doctor.experience,
};

// "Label: rest" points render the label in bold.
const items = points.map((item) => {
  const colonIdx = item.indexOf(": ");
  return {
    label: colonIdx !== -1 ? item.slice(0, colonIdx) : null,
    rest: colonIdx !== -1 ? item.slice(colonIdx + 2) : item,
  };
});
---

<section class="w-full bg-white pt-4 pb-4 my-4">
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10 lg:gap-8 xl:gap-12 items-center px-4 sm:px-6 lg:px-8">
    {/* LEFT CONTENT */}
    <div class="w-full max-w-2xl mx-auto lg:mx-0 text-center md:text-left">
      <h1 class="text-3xl md:text-4xl lg:text-3xl xl:text-4xl font-bold text-gray-900 leading-snug">{heading}</h1>
      {subheading && (
        <p class="text-gray-700 mt-2 font-bold text-lg md:text-[20px] lg:text-lg xl:text-[20px]">{subheading}</p>
      )}

      <ul class="mt-6 space-y-5 md:space-y-6 lg:space-y-5 text-left">
        {items.map(({ label, rest }) => (
          <li class="flex items-start md:items-center gap-3">
            <span class="w-6 h-6 mt-0.5 md:mt-0 flex items-center justify-center rounded-full bg-[#625587] text-white text-sm shrink-0">✓</span>
            <span class="text-base md:text-lg lg:text-base xl:text-lg text-gray-700">{label && <strong>{label}: </strong>}{rest}</span>
          </li>
        ))}
      </ul>

      <ContactCta class="inline-block mt-6 md:mt-8 bg-[#F8B956] hover:bg-transparent transition text-white hover:text-black border-2 border-transparent hover:border-[#F8B956] font-semibold rounded-full px-6 md:px-8 py-3 text-base md:text-lg">{buttonText}</ContactCta>
    </div>

    {/* RIGHT IMAGE */}
    <div class="w-full max-w-md md:max-w-lg lg:max-w-md mx-auto">
      {imageSrc && (
        <div class="relative w-full h-64 sm:h-80 md:h-96 lg:h-[360px] xl:h-[400px] rounded-xl overflow-hidden z-0">
          <Image
            src={imageSrc}
            alt={heading}
            fill
            preload
            fetchpriority="high"
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 32rem, 28rem"
            class="object-cover"
          />
        </div>
      )}
      <div class="bg-gray-100 rounded-b-xl w-full px-4 py-5 md:py-6 -mt-4 pt-8 relative z-10 shadow-sm">
        <ul class="text-gray-800 font-medium space-y-1 flex flex-col items-center justify-center text-sm md:text-base text-center">
          <li>{doctorInfo.name}</li>
          <li>{doctorInfo.qualifications}</li>
          <li>{doctorInfo.designation}</li>
          <li>{doctorInfo.experience}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
