---
// Astro port of cost.jsx (static).
import Image from "@/lib/Image.astro";
import ContactCta from "@/components/ContactCta.astro";

type Props = {
  title?: string;
  points?: string[];
  buttonText?: string;
  imageSrc?: string;
};

const { title, points, buttonText, imageSrc } = Astro.props;
---

<div class="w-full bg-teal-50 rounded-2xl p-6 md:p-10">
  <div class="flex flex-col md:flex-row items-center justify-between gap-8">
    {/* Left Section */}
    <div class="flex flex-col items-start gap-4 max-w-md">
      <div>
        <h2 class="text-[30px] sm:text-[32px] font-semibold text-gray-900 mb-4">{title}</h2>

        <ul class="mt-2 text-gray-600 text-[16px] sm:text-[18px] list-disc list-outside pl-2 sm:pl-6 space-y-2">
          {points?.map((point) => <li>{point}</li>)}
        </ul>
      </div>

      <ContactCta class="inline-block mt-3 rounded-full bg-[#625587] px-8 py-4 text-sm font-medium text-white hover:bg-teal-600 transition-all duration-300 ease-[cubic-bezier(.22,.61,.36,1)] hover:ml-4">{buttonText}</ContactCta>
    </div>
    {/* Right Section */}
    {imageSrc && (
      <div class="hidden md:block w-full max-w-md rounded-2xl p-2 text-center">
        <Image src={imageSrc} alt="Surgery Cost" width={250} height={200} class="mx-auto mb-4 rounded-lg" />
      </div>
    )}
  </div>
</div>
