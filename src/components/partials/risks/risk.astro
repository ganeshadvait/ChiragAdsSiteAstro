---
const { heading, risks } = Astro.props;
---

<div class="w-full max-w-5xl mx-auto rounded-xl md:p-6 px-4">
  <h2 class="text-[24px] sm:text-[30px] font-semibold mb-8 text-[#625587]">{heading}</h2>

  <ul class="space-y-6 text-gray-800">
    {risks.map((item) => (
      <li class="flex items-start gap-4 transition-all duration-300 ease-[cubic-bezier(.22,.61,.36,1)] hover:ml-4 border border-transparent hover:border-gray-100 rounded-lg p-2 w-fit">
        <span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
