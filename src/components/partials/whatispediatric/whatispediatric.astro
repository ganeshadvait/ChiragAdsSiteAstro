---
// Astro port of whatispediatric.tsx. No client script: the video relies on
// the native autoplay/muted/loop attributes.
type Chunk = string | { text: string };

type Props = {
  heading?: string;
  paragraphs?: (string | Chunk[])[];
  image?: string;
  imageAlt?: string;
  video?: string;
  poster?: string;
};

const {
  heading = "What Is Pediatric Anal Care?",
  paragraphs,
  image = "/ladypilestypes.png",
  imageAlt = "Pediatric anal care illustration",
  video,
  poster,
} = Astro.props;

const items = paragraphs || [];
---

<section class="w-full max-w-6xl mx-auto px-4">
  <div class="rounded-3xl md:px-10 md:py-6">
    <h2 class="text-2xl md:text-3xl font-bold text-[#1E1B4B] mb-6">{heading}</h2>

    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-8 items-center">
      {/* LEFT: Text content */}
      <div class="space-y-5 text-gray-700 leading-relaxed text-[15px] md:text-base">
        {items.map((para) => (
          <p>{typeof para === "string" ? para : (para || []).map((chunk) => <span>{typeof chunk === "string" ? chunk : chunk.text}</span>)}</p>
        ))}
      </div>

      {/* RIGHT: Illustration / video card */}
      <div class="flex justify-center">
        <div class="w-full max-w-[360px] aspect-[4/3] rounded-2xl overflow-hidden flex items-center justify-center">
          {video ? (
            <video src={video} poster={poster} class="w-full h-full object-cover" autoplay muted loop playsinline controls></video>
          ) : (
            <img src={image} alt={imageAlt} class="w-full h-full object-cover" />
          )}
        </div>
      </div>
    </div>
  </div>
</section>
