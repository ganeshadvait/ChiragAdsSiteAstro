---
// Astro port of ctabanner.jsx (static).
import Image from "@/lib/Image.astro";
import ContactCta from "@/components/ContactCta.astro";

type Props = {
  heading?: string;
  buttonText?: string;
  imageSrc?: string;
};

const { heading, buttonText, imageSrc } = Astro.props;
---

<section class="px-0 md:p-6">
  <div class="w-full border border-blue-300 rounded-3xl bg-blue-50 flex flex-col md:flex-row items-center justify-between ">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 w-full">
      {/* Left Section */}
      <div class="flex flex-col items-start gap-4 w-full md:basis-7/10 p-6 md:p-8">
        <h2 class="text-[32px] font-bold text-gray-900">{heading}</h2>

        <ContactCta class="inline-block mt-3 rounded-full bg-[#625587] px-8 py-4 text-sm font-medium text-white hover:bg-white hover:text-black hover:border border-[#625587] transition-all duration-300 ease-[cubic-bezier(.22,.61,.36,1)] hover:ml-4">{buttonText}</ContactCta>
      </div>

      {/* Right Section */}
      {imageSrc && (
        <div class="hidden md:block md:basis-3/10 rounded-2xl text-center">
          <div class="relative mx-auto w-[90%] aspect-square">
            <Image src={imageSrc} alt="Health CTA" fill sizes="(max-width: 1500px) 25vw, 380px" class="rounded-lg " />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
