---
import Image from "@/lib/Image.astro";
import ContactCta from "@/components/ContactCta.astro";

export interface DoctorInfo {
  image?: string;
  name?: string;
  qualifications?: string;
  designation?: string;
  subDesignation?: string;
  experience?: string;
  booklink?: string;
  intro?: string;
  intro2?: string;
  highlights?: string[];
}

interface Props {
  doctor?: DoctorInfo;
}

const DEFAULT_DOCTOR: DoctorInfo = {
  image: "/api/placeholder/300/300",
  name: "Dr. Name",
  qualifications: "Qualifications",
  designation: "Specialist",
  experience: "Experience",
  booklink: "#",
  intro: "Introduction content goes here.",
  intro2: "Experience description goes here.",
  highlights: ["Expertise item 1", "Expertise item 2", "Expertise item 3"],
};

const { doctor = {} } = Astro.props;
const merged = { ...DEFAULT_DOCTOR, ...doctor };
---

<section>
  <div class="doctorhero flex items-stretch justify-center">
    <div class="doctorhero__left" style="background:radial-gradient(125% 125% at 50% 10%, #fff 40%, #C5B4F5 100%)">
      <div class="flex flex-col items-center justify-center">
        <div class="w-full h-full">
          <div class="doctorhero__img-container">
            <div class="relative mb-2 h-[270px] w-auto min-w-[300px] rounded-[20px] flex items-center justify-center">
              <Image
                src={merged.image || "/api/placeholder/300/300"}
                alt={merged.name || "Doctor"}
                fill
                class="doctorhero__img object-cover rounded-[20px]"
              />
            </div>
          </div>
          <h3 class="text-2xl font-bold text-gray-800 mb-1 text-center">{merged.name || "Doctor Name"}</h3>
          <p class="text-sm text-gray-600 mb-1 text-center">{merged.qualifications || "Qualifications"}</p>
          <p class="text-sm text-gray-600 mb-1 text-center">{merged.designation || "Specialist"}</p>
          {merged.subDesignation && (
            <p class="text-sm text-gray-600 mb-1 text-center">{merged.subDesignation}</p>
          )}
          <div class="flex items-center justify-center gap-2 text-gray-700 mb-2">
            {/* lucide:briefcase, as rendered by @iconify/react */}
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--lucide w-5 h-5" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></g></svg>
            <span>Experience: {merged.experience || "N/A"}</span>
          </div>
          <ContactCta class="w-full h-[45px] text-white rounded-full mb-2 bg-[#F8B956] flex items-center justify-center">Book Appointment</ContactCta>
        </div>
      </div>
    </div>
    <div class="doctorhero__right">
      <div class="p-6">
        <section class="mb-8">
          <h3 class="text-2xl font-bold text-gray-800 mb-4">Introduction:</h3>
          <p class="text-gray-600 leading-relaxed">{merged.intro || "Introduction content not available."}</p>
        </section>

        <section>
          <h3 class="text-2xl font-bold text-gray-800 mb-4">Experience: {merged.intro2 || "Experience details not available."}</h3>
          <ul class="space-y-3 text-gray-600">
            {merged.highlights && merged.highlights.length > 0 ? (
              merged.highlights.map((highlight) => (
                <li class="flex items-center gap-2">
                  {/* lucide:check-circle, as rendered by @iconify/react */}
                  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--lucide w-5 h-5 text-purple-600 flex-shrink-0" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11l3 3L22 4"/></g></svg>
                  {highlight}
                </li>
              ))
            ) : (
              <li class="text-gray-500">No highlights available</li>
            )}
          </ul>
        </section>
      </div>
    </div>
  </div>
</section>
