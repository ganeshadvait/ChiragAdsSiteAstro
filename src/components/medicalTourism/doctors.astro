---
// File: components/medicalTourism/doctors.astro
import ConsultationForm from "./form.astro";

const doctors = [
  {
    name: "Dr. Rajashekar M R",
    qualification: "MBBS, MS General Surgeon",
    role: "Founder & Chief Proctologist",
    experience: "42+ Years",
    badge: "Founder",
    image: "/doctorchiragcard.avif",
  },
  {
    name: "Dr. Shreedevi K.N.",
    qualification: "MBBS, MS, FSGE Surgical",
    role: "Gastroenterology & Colorectal Surgeon",
    experience: "12 Years",
    image: "/doctorshreedevicard.avif",
  },
  {
    name: "Dr. Padmanabh R Bhat",
    qualification: "MBBS, MS(Gen Surgery), FRCS(Edin)",
    role: "General Surgeon",
    experience: "28+ Years",
    image: "/Dr. Padmanabh R Bhat.png",
  },
];
---

<section
  id="doctors"
  data-mt-doctors
  class="border-b border-[#625587]/10 bg-white px-4 py-14 sm:px-6 lg:px-8 lg:py-16"
>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <span class="mb-3 inline-block text-xs font-semibold uppercase tracking-[2px] text-[#C8963E]">Meet Your Treating Specialists</span>

      <h2 class="text-3xl font-bold leading-tight text-[#625587] sm:text-4xl">India&apos;s Most Experienced Proctologists</h2>

      <p class="mt-3 text-sm leading-7 text-[#5A7078] sm:text-base">
        Led by Dr. Rajasekhar Mysore — 30+ years, 180k+ Patients Treated.
        You&apos;ll be treated by the specialist, not handed off to a
        junior.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {doctors.map((doctor) => (
        <div class="group relative overflow-hidden rounded-[18px] border border-[#625587]/10 bg-[#FAF7F3] px-5 pb-6 pt-7 text-center transition duration-300 hover:-translate-y-1.5 hover:border-[#625587] hover:shadow-[0_4px_32px_rgba(11,79,90,0.10)] sm:px-6">
          <div class="absolute left-0 top-0 h-1 w-full bg-gradient-to-r from-[#C8963E] to-[#2A8A9E] opacity-0 transition duration-300 group-hover:opacity-100"></div>

          {doctor.badge && (
            <div class="absolute right-4 top-4 rounded-full bg-[#F8B956] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.5px] text-white">{doctor.badge}</div>
          )}

          <div class="mx-auto mb-4 h-[110px] w-[110px] overflow-hidden rounded-full border-[3px] border-[#C8963E]/25 shadow-[0_4px_20px_rgba(11,79,90,0.15)]">
            <img src={doctor.image} alt={doctor.name} class="h-full w-full object-cover" />
          </div>

          <div class="text-xl font-bold text-[#625587]">{doctor.name}</div>

          <div class="mt-1 text-xs font-semibold tracking-[0.5px] text-[#C8963E]">{doctor.qualification}</div>

          <div class="mt-2 text-sm leading-6 text-[#5A7078]">{doctor.role}</div>

          <div class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-[#625587]/7 px-3 py-1.5 text-xs font-semibold text-[#625587]">
            <span>⏱</span>
            <span>{doctor.experience}</span>
          </div>

          <button
            data-popup-open
            class="mt-4 block w-full rounded-4xl bg-[#625587] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#F8B956]"
          >
            Book Consultation
          </button>
        </div>
      ))}
    </div>
  </div>

  {/* Consultation Form Modal (hidden until a "Book Consultation" button is clicked) */}
  <div
    data-popup
    hidden
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 pt-20 backdrop-blur-sm"
  >
    <div
      data-popup-panel
      class="relative w-full max-w-md rounded-[20px] bg-white p-7 text-[#1C2B30] shadow-[0_12px_64px_rgba(11,79,90,0.16)] sm:p-8"
    >
      <button
        data-popup-close
        class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-[#5A7078] transition hover:bg-gray-100 hover:text-[#1C2B30]"
        aria-label="Close"
      >
        ✕
      </button>

      <h3 class="text-2xl font-bold text-[#625587]">Book Your Consultation</h3>
      <p class="mt-1 text-sm text-[#5A7078]">
        We&apos;ll respond within 2 hours with a detailed plan &amp; cost
        estimate.
      </p>

      <ConsultationForm source="doctors_section" />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-mt-doctors]").forEach((root) => {
    const popup = root.querySelector<HTMLElement>(":scope > [data-popup]")!;
    const panel = popup.querySelector<HTMLElement>("[data-popup-panel]")!;
    // React unmounted the popup form on close, so reopening shows a fresh form.
    const close = () => {
      popup.hidden = true;
      popup.querySelector("form")?.reset();
    };

    root.querySelectorAll("[data-popup-open]").forEach((btn) =>
      btn.addEventListener("click", () => (popup.hidden = false)),
    );
    popup.querySelector("[data-popup-close]")!.addEventListener("click", close);
    // Backdrop click closes; clicks inside the panel don't.
    popup.addEventListener("click", close);
    panel.addEventListener("click", (e) => e.stopPropagation());
  });
</script>
